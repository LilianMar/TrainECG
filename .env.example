# Copia este archivo como .env y completa los valores antes de ejecutar docker-compose:
#   cp .env.example .env

# === REQUERIDO ===

# Clave secreta para JWT. SI NO SE SETEA, docker-compose falla intencionalmente.
# Generar con: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave-secreta

# === RECOMENDADO ===

# API Key de OpenAI para explicaciones del clasificador y recomendaciones.
# Si se deja vacío, el sistema usa textos de respaldo sin IA generativa.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# URL del backend que el navegador del usuario debe usar para llamadas al API.
# Se inyecta en runtime (NO requiere reconstruir la imagen del frontend).
#  - Local con docker-compose:                http://localhost:8000
#  - Mismo dominio + reverse proxy en /api:   /api
#  - USB Cali (subpath /trainECG/):           /trainECG/api
#  - Backend en URL absoluta:                 https://api.midominio.com
API_URL=

# Orígenes permitidos por CORS (lista separada por comas).
# Solo necesario si el frontend está en distinto dominio que el backend.
# Si comparten origen, puede omitirse.
#   Local:     http://localhost:9000
#   USB Cali:  https://lidis.usbcali.edu.co
BACKEND_CORS_ORIGINS=http://localhost:9000

# === SUBPATH DEL FRONTEND (build-time) ===

# Si la app NO se sirve en la raíz del dominio sino bajo un prefijo,
# definir el prefijo con barras inicial y final.
#  - Raíz del dominio:               /
#  - USB Cali (lidis/trainECG/):     /trainECG/
VITE_BASE_PATH=/

# === OPCIONAL (build-time) ===

# Fallback de URL del API si runtime-config.js no se encuentra.
# Normalmente NO hace falta: el entrypoint del frontend siempre regenera
# runtime-config.js desde API_URL.
VITE_API_URL=
